        <mxCell id="T1" value="一、订单处理 · 合同审批 · 回签留档" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#19334a;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="52" width="1160" height="32" as="geometry" />
        </mxCell>
        <mxCell id="T2" value="二、付款与结清" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#19334a;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="1170" width="1160" height="32" as="geometry" />
        </mxCell>
        <mxCell id="A1" value="图例&lt;br&gt;━━━━━━━━&lt;br&gt;实线：正常流转&lt;br&gt;橙色虚线：退回修改&lt;br&gt;青色线：审批通过&lt;br&gt;菱形：判断节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b67e;dashed=1;fontColor=#5a4630;fontSize=10;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="980" y="250" width="196" height="150" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="关键规则&lt;br&gt;1. 合同：许总一级 → 严总/张总二级，任一通过即可；任一级退回均从许总一级重审&lt;br&gt;2. 付款：严总/张总任一通过，不设许总一级；驳回仅重提严总/张总并保留付款类型&lt;br&gt;3. 订金前须回签留档；其他货款前须采购员确认已出货&lt;br&gt;4. 每次付款单独申请／审批／财务确认，无需上传凭证；一次付款完成不等于合同完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b67e;dashed=1;fontColor=#5a4630;fontSize=10;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="980" y="430" width="196" height="220" as="geometry" />
        </mxCell>
        <mxCell id="A3" value="待定项&lt;br&gt;· 电子印章稍后提供并配置&lt;br&gt;· 出运明细生成／上传方式未规定&lt;br&gt;· 本图描述目标流程，不代表工具已全部实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b67e;dashed=1;fontColor=#5a4630;fontSize=10;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="980" y="670" width="196" height="120" as="geometry" />
        </mxCell>
        <mxCell id="A4" value="自动发送邮件&lt;br&gt;收件人：供应商、对应业务员、严总、张总、许总、该合同采购员&lt;br&gt;附件：盖章合同 PDF ＋ 出运明细" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b67e;dashed=1;fontColor=#5a4630;fontSize=10;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
